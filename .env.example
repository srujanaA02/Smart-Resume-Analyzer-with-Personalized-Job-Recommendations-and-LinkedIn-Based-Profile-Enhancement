# .env.example - copy to `.env` and fill values (DO NOT COMMIT actual secrets)

# Database configuration
DB_PATH=data/database.db

# Chrome / WebDriver settings (for the LinkedIn scraper)
# Use `CHROMEDRIVER_PATH` to point to a local chromedriver binary (recommended)
CHROMEDRIVER_PATH=
# If running a custom Chrome/Chromium binary (e.g., in containers), set this
CHROME_BINARY_PATH=
# Run Chrome in headless mode for server deployments
CHROME_HEADLESS=true

# Optional: LinkedIn Credentials for Scraping
LINKEDIN_EMAIL=your_email
LINKEDIN_PASSWORD=your_password

# LLM / Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000

# API Keys (example placeholders)
# OPENAI_API_KEY=your_key_here
